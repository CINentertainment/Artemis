APPLICATION_NAME=Artemis
APPLICATION_VERSION=0.1.0
ENVIRONMENT=development

HOST=127.0.0.1
PORT=8200

DEBUG=false
TELEMETRY_ENABLED=false
EXTERNAL_ACCESS_ENABLED=false

